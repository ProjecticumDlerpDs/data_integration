install.packages("remotes")
remotes::install_github("satijalab/seurat-wrappers")

library(SeuratWrappers)
library(monocle3)
cds <- as.cell_data_set(e65)

Idents(e65)
cl <- Idents(e65)

parts <- factor(rep(1, length(cl)))
names(parts) <- names(cl)

cds@clusters$UMAP <- list(
  clusters = cl,
  partitions = parts,
  cluster_method = "precomputed",
  k = NA_integer_
)

reducedDims(cds)$UMAP <- Embeddings(e65, "umap")

cds <- learn_graph(cds)

plot_cells(cds, color_cells_by = "cluster")

cds <- order_cells(cds)

plot_cells(cds, color_cells_by = "pseudotime")



plot_cells(cds, color_cells_by = "cluster", show_trajectory_graph = FALSE)